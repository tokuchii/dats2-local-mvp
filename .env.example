# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dats2.0

# AI model backend for structured system assessment
# Use either DeepSeek/OpenAI-compatible or a local Llama/Ollama endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# For local Llama via Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_MODEL=llama3.1

REVIEWER_TOKEN=change-this-local-reviewer-token
DATS2_HOST=127.0.0.1
DATS2_PORT=8501
MAX_UPLOAD_MB=25
